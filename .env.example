# Shared internal service credential. Set the same value for backend and AI service.
MEDPILOT_AI_SERVICE_TOKEN=replace-with-a-long-random-service-token
MEDPILOT_AI_SERVICE_URL=http://127.0.0.1:8000
MEDPILOT_REDIS_URL=redis://127.0.0.1:6379/0
MEDPILOT_REDIS_REQUIRED=true
MEDPILOT_REDIS_ENABLED=true
MEDPILOT_REDIS_KEY_PREFIX=medpilot
# At least 16 bytes; derive a separate secret in production rather than reusing a service token.
MEDPILOT_REDIS_KEY_HMAC_SECRET=replace-with-a-random-redis-key-secret
# In a production/shared-state deployment, Spring supplies persisted history
# on every turn; the AI process must not retain clinical text in memory.
MEDPILOT_SESSION_HISTORY_SOURCE=backend

# Backend production secrets. JWT_SECRET must be at least 32 bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes
MEDPILOT_DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Optional rotation ring: comma-separated id=base64-32-byte-key entries.
MEDPILOT_DATA_ENCRYPTION_KEYS=
MEDPILOT_DATA_ENCRYPTION_ACTIVE_KEY_ID=v1
MEDPILOT_AUDIT_IP_SALT=replace-with-audit-only-salt

# Hospital identity. Keep the local fallback disabled for a production rollout;
# replace the OIDC placeholders with the hospital IdP registration values.
MEDPILOT_LOCAL_PASSWORD_LOGIN_ENABLED=false
MEDPILOT_OIDC_ENABLED=false
MEDPILOT_OIDC_ISSUER_URI=https://idp.hospital.example/issuer
MEDPILOT_OIDC_AUDIENCE=medpilot-clinical
MEDPILOT_OIDC_JWK_SET_URI=
MEDPILOT_OIDC_MFA_CLAIM=acr
MEDPILOT_OIDC_REQUIRED_MFA_ASSURANCE_LEVEL=2
MEDPILOT_OIDC_ALLOW_INSECURE_HTTP=false

# Backend database.
DB_URL=jdbc:mysql://127.0.0.1:3306/medpilot?useSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USER=medpilot
DB_PASSWORD=replace-with-a-strong-database-password
JPA_DDL_AUTO=validate

# AI runtime.
OLLAMA_BASE=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
MEDPILOT_RAG_MIN_SCORE=0.35
MEDPILOT_INFERENCE_MAX_CONCURRENCY=2
MEDPILOT_INFERENCE_QUEUE_TIMEOUT_SECONDS=0.05
MEDPILOT_CONSULT_TIMEOUT_SECONDS=180
MEDPILOT_AI_RETRY_MAX_RETRIES=1
MEDPILOT_AI_RETRY_BACKOFF_MS=100
# Model-release evidence. Keep blank only for local development; clinical mode
# readiness fails closed until a signed, evaluated and frozen release is set.
MEDPILOT_RUNTIME_MODE=development
MEDPILOT_MODEL_RELEASE_ID=unregistered-dev
MEDPILOT_MODEL_VERSION=dev
MEDPILOT_MODEL_WEIGHT_SHA256=
MEDPILOT_MODEL_ARTIFACT_SIGNATURE=
MEDPILOT_MODEL_SIGNATURE_ALGORITHM=
MEDPILOT_PROMPT_VERSION=dev
MEDPILOT_EMBEDDING_VERSION=bge-m3
MEDPILOT_KNOWLEDGE_INDEX_VERSION=unregistered-dev
MEDPILOT_MODEL_SCOPE=development-only
MEDPILOT_MODEL_RELEASE_STATUS=DRAFT
MEDPILOT_ATTACHMENTS_STORAGE_DIR=./var/private/attachments
MEDPILOT_ATTACHMENTS_RETENTION_DAYS=30
